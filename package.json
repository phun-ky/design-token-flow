{
  "name": "@phun-ky/design-token-flow",
  "private": true,
  "version": "0.1.0",
  "description": "Design token relations",
  "type": "module",
  "scripts": {
    "test": "glob -c \"node --import tsx --import global-jsdom/register --test --no-warnings\" \"./src/**/__tests__/**/*.[jt]s\"",
    "pretest-ci": "rm -rf coverage && mkdir -p coverage",
    "test-ci": "glob -c \"node --import tsx --import global-jsdom/register --test --no-warnings --experimental-test-coverage --test-reporter=cobertura --test-reporter-destination=coverage/cobertura-coverage.xml --test-reporter=spec --test-reporter-destination=stdout\" \"./src/**/__tests__/**/*.[jt]s\"",
    "clean": "rm -rf dist",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "docs:gen": "node ./node_modules/.bin/typedoc --entryPoints src --entryPointStrategy expand --gitRevision main --githubPages false --plugin typedoc-plugin-markdown --tsconfig tsconfig.json --hideInPageTOC --out api --readme none",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "style:code": "npx putout src",
    "commit": "npx git-cz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/design-token-flow.git"
  },
  "keywords": [
    "html",
    "css",
    "design",
    "design system",
    "javascript",
    "spec",
    "inspect",
    "annotation",
    "annotate",
    "pin",
    "specifications",
    "anatomy",
    "dissection",
    "dissect",
    "documentation",
    "information",
    "specification",
    "specs",
    "html-elements",
    "inspect",
    "spacing",
    "design-token-flow",
    "a11y",
    "accessibility"
  ],
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phun-ky/design-token-flow/issues"
  },
  "homepage": "https://github.com/phun-ky/design-token-flow#readme",
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.4.2",
    "cobertura": "^1.0.1",
    "eslint": "^10.13.0",
    "eslint-config-phun-ky": "^2.0.10",
    "git-cz": "^4.9.0",
    "glob": "^10.3.10",
    "global-jsdom": "^24.0.0",
    "globals": "^17.13.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.9.10",
    "putout": "^35.1.0",
    "quibble": "^0.9.1",
    "stylus": "^0.62.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.3.1",
    "tsx": "^4.7.1",
    "typedoc": "^0.25.8",
    "typedoc-plugin-frontmatter": "^0.0.2",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-plugin-mdn-links": "^3.1.16",
    "typedoc-plugin-no-inherit": "^1.4.0",
    "typedoc-plugin-rename-defaults": "^0.7.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "engines": {
    "node": ">=21.7.1",
    "npm": ">=10.8.2"
  },
  "dependencies": {
    "@phun-ky/arclace": "^1.0.0"
  }
}
