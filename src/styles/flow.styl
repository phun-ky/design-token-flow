// App styles for the flow view. Pill styles live in ../tokens/styles

:root
  --dtf-line-color #5B6275
  --dtf-lane-label-color #9FA8AD
  --dtf-flow-column-gap 4rem
  --dtf-flow-token-gap 1rem

:root.theme--light
  --dtf-line-color #97AABD
  --dtf-lane-label-color #6F7582

// Lines between tokens are drawn by @phun-ky/arclace
.dtf-line
  color var(--dtf-line-color)

// Layout from layoutTokens(): inheritance lanes, then unconnected tokens.
// The canvas is at least as wide as the viewport, and wider when the lanes need it
.container
  display flex
  flex-direction column
  gap 4rem
  width max-content
  min-width 100%
  padding 2rem 3rem 6rem

.section-label,
.lane-label,
.column-label,
.token-group-label
  margin 0
  font-family var(--dtf-font-family)
  font-weight 600
  letter-spacing 0.06em
  text-transform uppercase
  color var(--dtf-lane-label-color)

.section-label
  font-size 0.8125rem
  margin-bottom 1.5rem

.lane-label
  font-size 0.75rem
  margin-bottom 1rem

.column-label,
.token-group-label
  font-size 0.6875rem
  font-weight 500

.token-group-label
  margin-bottom 0.75rem

// Inheritance: one stack of tokens per alias depth. The header and the stacks share the
// section's columns (subgrid). A column is never narrower than its widest token
.flow
  display grid
  grid-template-columns repeat(var(--flow-columns), minmax(max-content, 1fr))
  column-gap var(--dtf-flow-column-gap)

  > .section-label
    grid-column 1 / -1

.flow-row
  grid-column 1 / -1
  display grid
  grid-template-columns subgrid
  align-items center
  justify-items center

.flow-header
  margin-bottom 1.5rem

// Every stack uses the same gap between tokens, whatever the token size
.flow-column
  display flex
  flex-direction column
  align-items center
  gap var(--dtf-flow-token-gap)

// Unconnected tokens: wrapped groups per type. Zero width with a full min-width, so
// the wrapped rows fill the canvas without making it wider
.loose
  width 0
  min-width 100%

.lane-loose + .lane-loose
  margin-top 2.5rem

.lane-groups
  display flex
  flex-direction column
  gap 2rem

.lane-loose .token-group-list
  display flex
  flex-wrap wrap
  align-items center
  gap 0.75rem
