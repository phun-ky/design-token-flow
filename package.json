{
  "name": "site-design-token-flow",
  "private": true,
  "version": "0.1.0",
  "description": "Design token relations",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test --enable-source-maps 'src/**/__tests__/**/*.ts'",
    "pretest-ci": "rm -rf coverage && mkdir -p coverage",
    "test-ci": "node --import tsx --test --enable-source-maps --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/__tests__/**' --test-coverage-exclude='src/**/types/**' --test-coverage-lines=85 --test-coverage-branches=90 --test-coverage-functions=97 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'src/**/__tests__/**/*.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "prepare": "git config core.hooksPath .githooks || true",
    "clean": "rm -rf dist",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commit": "npx git-cz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/site-design-token-flow.git"
  },
  "keywords": [
    "html",
    "css",
    "design",
    "design system",
    "javascript",
    "spec",
    "inspect",
    "annotation",
    "annotate",
    "pin",
    "specifications",
    "anatomy",
    "dissection",
    "dissect",
    "documentation",
    "information",
    "specification",
    "specs",
    "html-elements",
    "inspect",
    "spacing",
    "design-token-flow",
    "a11y",
    "accessibility"
  ],
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phun-ky/site-design-token-flow/issues"
  },
  "homepage": "https://github.com/phun-ky/site-design-token-flow#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-phun-ky": "^2.0.10",
    "git-cz": "^4.9.0",
    "global-jsdom": "^30.0.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "engines": {
    "node": ">=21.7.1",
    "npm": ">=10.8.2"
  },
  "dependencies": {
    "@phun-ky/arclace": "^1.0.0",
    "shiki": "^4.5.0"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "^0.18.11"
    }
  }
}
