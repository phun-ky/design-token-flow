{
  "name": "@phun-ky/design-token-flow",
  "private": true,
  "version": "0.1.0",
  "description": "Design token relations",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test --enable-source-maps 'src/**/__tests__/**/*.ts'",
    "pretest-ci": "rm -rf coverage && mkdir -p coverage",
    "test-ci": "node --import tsx --test --enable-source-maps --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/__tests__/**' --test-coverage-exclude='src/**/types/**' --test-coverage-lines=85 --test-coverage-branches=90 --test-coverage-functions=97 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'src/**/__tests__/**/*.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "prepare": "git config core.hooksPath .githooks || true",
    "clean": "rm -rf dist",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "docs:gen": "node ./node_modules/.bin/typedoc --entryPoints src --entryPointStrategy expand --gitRevision main --githubPages false --plugin typedoc-plugin-markdown --tsconfig tsconfig.json --hideInPageTOC --out api --readme none",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "style:code": "npx putout src",
    "commit": "npx git-cz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/design-token-flow.git"
  },
  "keywords": [
    "html",
    "css",
    "design",
    "design system",
    "javascript",
    "spec",
    "inspect",
    "annotation",
    "annotate",
    "pin",
    "specifications",
    "anatomy",
    "dissection",
    "dissect",
    "documentation",
    "information",
    "specification",
    "specs",
    "html-elements",
    "inspect",
    "spacing",
    "design-token-flow",
    "a11y",
    "accessibility"
  ],
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phun-ky/design-token-flow/issues"
  },
  "homepage": "https://github.com/phun-ky/design-token-flow#readme",
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-phun-ky": "^2.0.10",
    "git-cz": "^4.9.0",
    "global-jsdom": "^24.0.0",
    "globals": "^17.13.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.9.10",
    "putout": "^35.1.0",
    "quibble": "^0.13.0",
    "stylus": "^0.64.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.8.1",
    "tsx": "^4.7.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^0.0.2",
    "typedoc-plugin-markdown": "^3.17.1",
    "typedoc-plugin-mdn-links": "^3.1.16",
    "typedoc-plugin-no-inherit": "^1.6.1",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^5.0.0",
    "vite": "^8.3.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "engines": {
    "node": ">=21.7.1",
    "npm": ">=10.8.2"
  },
  "dependencies": {
    "@phun-ky/arclace": "^1.0.0"
  }
}
